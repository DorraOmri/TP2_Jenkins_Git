pipeline {
    agent any

    options {
        timestamps()
    }

    stages {
        stage('Cloner le dépôt') {
            steps {
                git url: 'https://github.com/DorraOmri/TP2_Jenkins_Git.git', branch: 'main'
            }
        }

        stage('Étape 1 : Vérification du dépôt') {
            steps {
                sh 'echo "=== Étape 1 : Vérification du dépôt ==="'
                sh 'git status'
            }
        }

        stage('Étape 2 : Afficher le contenu du projet') {
            steps {
                sh 'echo "=== Étape 2 : Afficher le contenu du projet ==="'
                sh 'ls -la'
            }
        }

        stage('Étape 3 : Simuler un déploiement local') {
            steps {
                sh 'echo "=== Étape 3 : Simuler un déploiement local ==="'
                sh 'echo "Le fichier index.html est prêt à être affiché"'
            }
        }

        stage('Étape 4 : Fin du build') {
            steps {
                sh 'echo "=== Étape 4 : Fin du build ==="'
                sh 'echo "SUCCESS"'
            }
        }
    }

    post {
        success {
            echo 'Build OK'
        }
        failure {
            echo 'Build KO'
        }
    }
}
